def fetch_brawl_stars(endpoint: str, output: str) -> str:
	return f"wget --header=\"Authorization: Bearer $BSTOK\" -qO- 'https://api.brawlstars.com/v1/{endpoint}' | jq '.' > {output}"


rule brawlers:
	output:
		"data/brawlers.json"
	shell:
		fetch_brawl_stars("brawlers", "{output}")


rule brawler_names:
	input:
		"data/brawlers.json"
	output:
		"data/brawler_names.json"
	shell:
		"jq '[.items[] | {{name: .name, id: .id}}]' {input} > {output}"


rule brawler_classes:
	input:
		"data/brawler_names.json"
	output:
		"data/brawler_class.json"
	run:
		import json, re, time, urllib.parse, urllib.request

		wiki_title_overrides = {"8-BIT": "8-Bit", "R-T": "R-T"}

		def parse_field(wikitext, field):
			m = re.search(rf"\|{field}\s*=\s*([^|}}'\n]+)", wikitext)
			return m.group(1).strip() if m else None

		def max_range(raw):
			if raw is None:
				return None
			nums = re.findall(r"\d+(?:\.\d+)?", raw)
			return max(float(n) for n in nums) if nums else None

		brawlers = json.load(open(input[0]))
		results = []

		for brawler in brawlers:
			name = brawler["name"]
			title = wiki_title_overrides.get(name) or " ".join(w.capitalize() for w in name.split())
			encoded = urllib.parse.quote(title)
			url = (
				f"https://brawlstars.fandom.com/api.php"
				f"?action=parse&page={encoded}&format=json&prop=wikitext"
			)
			req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
			with urllib.request.urlopen(req) as resp:
				data = json.load(resp)
			wikitext = data.get("parse", {}).get("wikitext", {}).get("*", "")

			brawler_class = parse_field(wikitext, "Class")
			if brawler_class is None:
				print(f"WARNING: no class found for {name!r} (wiki title: {title!r})", flush=True)

			rarity = parse_field(wikitext, "Rarity")
			if rarity is None:
				print(f"WARNING: no rarity found for {name!r}", flush=True)

			attack_range = max_range(parse_field(wikitext, "AttackRange"))
			super_range = max_range(parse_field(wikitext, "SuperRange"))
			if attack_range is None:
				print(f"WARNING: no attack range for {name!r}", flush=True)
			if super_range is None:
				print(f"WARNING: no super range for {name!r}", flush=True)

			results.append({
				"id": brawler["id"],
				"name": name,
				"class": brawler_class,
				"rarity": rarity,
				"max_attack_range": attack_range,
				"max_super_range": super_range,
			})
			time.sleep(0.5)

		with open(output[0], "w") as f:
			json.dump(results, f, indent=2)


rule winrates:
	input:
		"data/crawl_{leg}.json"
	output:
		"data/winrates_{leg}.json"
	run:
		import json
		from collections import defaultdict

		raw = json.load(open(input[0]))
		# counts[(char_id, event_id)] -> [wins, total]
		counts: dict = defaultdict(lambda: [0, 0])

		for entry in raw["stats"]:
			event_id = entry["event_id"]
			a_wins = entry["a_wins"]
			total = entry["total"]
			for char_id in entry["team_a"]:
				counts[(char_id, event_id)][0] += a_wins
				counts[(char_id, event_id)][1] += total
			for char_id in entry["team_b"]:
				counts[(char_id, event_id)][0] += total - a_wins
				counts[(char_id, event_id)][1] += total

		# Raw win rate per (char, event)
		wr = {k: v[0] / v[1] for k, v in counts.items()}

		# Z-score normalize within each event so the target is relative advantage
		event_rates: dict = defaultdict(list)
		for (char_id, event_id), rate in wr.items():
			event_rates[event_id].append(rate)

		event_stats: dict = {}
		for event_id, rates in event_rates.items():
			mu = sum(rates) / len(rates)
			sigma = (sum((r - mu) ** 2 for r in rates) / len(rates)) ** 0.5
			event_stats[event_id] = (mu, sigma)

		results = []
		for (char_id, event_id), rate in sorted(wr.items()):
			mu, sigma = event_stats[event_id]
			z = (rate - mu) / sigma if sigma > 0 else 0.0
			results.append({"char_id": char_id, "event_id": event_id, "z_score": z})

		with open(output[0], "w") as f:
			json.dump(results, f, indent=2)


rule pickrates:
	input:
		"data/crawl_{leg}.json"
	output:
		"data/pickrates_{leg}.json"
	run:
		import json
		from collections import defaultdict

		raw = json.load(open(input[0]))
		# appearances[(char_id, event_id)] -> total games where char appeared
		appearances: dict = defaultdict(int)
		event_totals: dict = defaultdict(int)

		for entry in raw["stats"]:
			event_id = entry["event_id"]
			total = entry["total"]
			event_totals[event_id] += total
			for char_id in entry["team_a"] + entry["team_b"]:
				appearances[(char_id, event_id)] += total

		# Pick rate = appearances / (total_games * 6 slots per game)
		pick_rates = {
			(char_id, event_id): count / (event_totals[event_id] * 6)
			for (char_id, event_id), count in appearances.items()
		}

		# Z-score normalize within each event
		event_rates: dict = defaultdict(list)
		for (char_id, event_id), rate in pick_rates.items():
			event_rates[event_id].append(rate)

		event_stats: dict = {}
		for event_id, rates in event_rates.items():
			mu = sum(rates) / len(rates)
			sigma = (sum((r - mu) ** 2 for r in rates) / len(rates)) ** 0.5
			event_stats[event_id] = (mu, sigma)

		results = []
		for (char_id, event_id), rate in sorted(pick_rates.items()):
			mu, sigma = event_stats[event_id]
			z = (rate - mu) / sigma if sigma > 0 else 0.0
			results.append({"char_id": char_id, "event_id": event_id, "z_score": z})

		with open(output[0], "w") as f:
			json.dump(results, f, indent=2)


rule battlelog:
	output:
		"data/battles_{tag}.json"
	shell:
		fetch_brawl_stars("players/%23{wildcards.tag}/battlelog", "{output}")


rule tier_lists:
	"""Monte Carlo per-map first-pick tier lists, scored by the terminal BrawlModel."""
	input:
		terminal_ckpt="data/model/model.eqx",
		draft_ckpt="data/draft_model/draft_q.eqx",
		brawler_class="data/brawler_class.json",
		brawler_range="data/brawler_effective_range.json",
		brawler_destruction="data/brawler_destruction.json",
		events="data/events.json",
		winrates="data/winrates_leg1_20260827.json",
		pickrates="data/pickrates_leg1_20260827.json",
	output:
		"data/tier_lists.json"
	shell:
		"uv run tier-list --terminal-ckpt {input.terminal_ckpt} --draft-ckpt {input.draft_ckpt} --output {output}"


rule tier_lists_web:
	"""Copy the Monte Carlo tier lists into web/static for the tier-list UI."""
	input:
		"data/tier_lists.json"
	output:
		"web/static/data/tier_lists.json"
	shell:
		"cp {input} {output}"


rule export_onnx:
	"""Trace BrawlModel + DraftQNetwork to ONNX and write companion data for web/."""
	input:
		terminal_ckpt="data/model/model.eqx",
		draft_ckpt="data/draft_model/draft_q.eqx",
	output:
		"web/static/models/draft_q.onnx",
		"web/static/models/terminal_pick6.onnx",
		"web/static/data/char_encs.bin",
		"web/static/data/manifest.json",
		"web/static/data/metadata.json",
		"web/tests/fixtures/onnx_fixture.json",
	shell:
		"uv run export-onnx --terminal-ckpt {input.terminal_ckpt} --draft-ckpt {input.draft_ckpt}"
