from pathlib import Path


def fetch_brawl_stars(endpoint: str, output: str) -> str:
	return f"wget --header=\"Authorization: Bearer $BSTOK\" -qO- 'https://api.brawlstars.com/v1/{endpoint}' | jq '.' > {output}"


# Every crawl dataset on disk, discovered rather than listed, so a new
# crawl_<name>.json(.gz) is picked up without editing this file. Some crawls
# are committed gzipped (they're large, best-effort scrapes) -- glob both
# extensions so a `.gz`-only crawl still shows up.
CRAWLS = sorted(
	set(glob_wildcards("data/crawl_{crawl}.json").crawl)
	| set(glob_wildcards("data/crawl_{crawl}.json.gz").crawl)
)


def crawl_path(crawl: str) -> str:
	"""Resolve a crawl name to its on-disk file: plain `.json` if present, else `.json.gz`."""
	plain = f"data/crawl_{crawl}.json"
	return plain if Path(plain).exists() else f"data/crawl_{crawl}.json.gz"


rule brawlers:
	output:
		"data/brawlers.json"
	shell:
		fetch_brawl_stars("brawlers", "{output}")


rule brawler_names:
	input:
		"data/brawlers.json"
	output:
		"data/brawler_names.json"
	shell:
		"jq '[.items[] | {{name: .name, id: .id}}]' {input} > {output}"


rule brawler_classes:
	input:
		"data/brawler_names.json"
	output:
		"data/brawler_class.json"
	run:
		import json, re, time, urllib.parse, urllib.request

		wiki_title_overrides = {"8-BIT": "8-Bit", "R-T": "R-T"}

		def parse_field(wikitext, field):
			m = re.search(rf"\|{field}\s*=\s*([^|}}'\n]+)", wikitext)
			return m.group(1).strip() if m else None

		def max_range(raw):
			if raw is None:
				return None
			nums = re.findall(r"\d+(?:\.\d+)?", raw)
			return max(float(n) for n in nums) if nums else None

		brawlers = json.load(open(input[0]))
		results = []

		for brawler in brawlers:
			name = brawler["name"]
			title = wiki_title_overrides.get(name) or " ".join(w.capitalize() for w in name.split())
			encoded = urllib.parse.quote(title)
			url = (
				f"https://brawlstars.fandom.com/api.php"
				f"?action=parse&page={encoded}&format=json&prop=wikitext"
			)
			req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
			with urllib.request.urlopen(req) as resp:
				data = json.load(resp)
			wikitext = data.get("parse", {}).get("wikitext", {}).get("*", "")

			brawler_class = parse_field(wikitext, "Class")
			if brawler_class is None:
				print(f"WARNING: no class found for {name!r} (wiki title: {title!r})", flush=True)

			rarity = parse_field(wikitext, "Rarity")
			if rarity is None:
				print(f"WARNING: no rarity found for {name!r}", flush=True)

			attack_range = max_range(parse_field(wikitext, "AttackRange"))
			super_range = max_range(parse_field(wikitext, "SuperRange"))
			if attack_range is None:
				print(f"WARNING: no attack range for {name!r}", flush=True)
			if super_range is None:
				print(f"WARNING: no super range for {name!r}", flush=True)

			results.append({
				"id": brawler["id"],
				"name": name,
				"class": brawler_class,
				"rarity": rarity,
				"max_attack_range": attack_range,
				"max_super_range": super_range,
			})
			time.sleep(0.5)

		with open(output[0], "w") as f:
			json.dump(results, f, indent=2)


rule winrates:
	input:
		lambda wildcards: crawl_path(wildcards.leg)
	output:
		"data/winrates_{leg}.json"
	shell:
		"uv run compute-stats winrates --input {input} --output {output}"


rule pickrates:
	input:
		lambda wildcards: crawl_path(wildcards.leg)
	output:
		"data/pickrates_{leg}.json"
	shell:
		"uv run compute-stats pickrates --input {input} --output {output}"


rule battlelog:
	output:
		"data/battles_{tag}.json"
	shell:
		fetch_brawl_stars("players/%23{wildcards.tag}/battlelog", "{output}")


rule events:
	"""Resolve every event id seen in any crawl to its mode/map details (needs $BSTOK).

	An accumulator, not a pure function of one crawl: `events-crawl` loads the
	existing events.json and only queries the ids it doesn't already have, so
	the output is flagged `update()` -- without it Snakemake deletes the file
	first and every run becomes a full re-crawl of a rate-limited API.
	`update()` also backs the file up and restores it if the crawl dies
	partway, which a best-effort scrape does.

	`touch` at the end because a no-op run ("all ids already known") writes
	nothing, and without a newer mtime this rule would re-fire forever.

	Consumers take this as `ancient()` -- built if missing, but never a
	rerun trigger -- because a grown events.json widens the event/map vocab
	(`load_vocabs`) past what an existing terminal checkpoint was trained on,
	and everything downstream deserialises into that checkpoint's shapes.
	Cascading would therefore just crash (`embed_map_id` shape mismatch); the
	one step that reconciles a grown vocab is `geneus train --init-from`
	(`just continue-training`), which is deliberately outside this DAG. So
	new maps mean: refresh events.json, retrain the terminal model, then
	`just crawl-artifacts <crawl>`.
	"""
	input:
		[crawl_path(crawl) for crawl in CRAWLS]
	output:
		update("data/events.json")
	shell:
		"""
		for dataset in {input}; do
			uv run crawl events-crawl "$dataset" --output {output}
		done
		touch {output}
		"""


rule tier_lists:
	"""Monte Carlo per-map first-pick tier lists (random continuation), scored by the terminal BrawlModel."""
	input:
		terminal_ckpt="data/terminal_{crawl}/model.eqx",
		draft_ckpt="data/draft_{crawl}/draft_q_best.eqx",
		brawler_class="data/brawler_class.json",
		brawler_range="data/brawler_effective_range.json",
		brawler_destruction="data/brawler_destruction.json",
		events=ancient("data/events.json"),
	output:
		"data/tier_lists_{crawl}.json"
	shell:
		"uv run tier-list --terminal-ckpt {input.terminal_ckpt} --draft-ckpt {input.draft_ckpt} --policy random --output {output}"


rule tier_lists_optimal:
	"""Monte Carlo per-map first-pick tier lists (DraftQNetwork-optimal continuation).

	Same first-pick question as `tier_lists`, but the other five picks are
	drafted by the deployed draft model instead of uniformly at random --
	answers "what's my win rate if this brawler is my first pick and everyone
	else, on both teams, drafts well." No bans (in-distribution for
	draft_q_best.eqx, trained on no-ban scenarios).
	"""
	input:
		terminal_ckpt="data/terminal_{crawl}/model.eqx",
		draft_ckpt="data/draft_{crawl}/draft_q_best.eqx",
		brawler_class="data/brawler_class.json",
		brawler_range="data/brawler_effective_range.json",
		brawler_destruction="data/brawler_destruction.json",
		events=ancient("data/events.json"),
	output:
		"data/tier_lists_optimal_{crawl}.json"
	shell:
		"uv run tier-list --terminal-ckpt {input.terminal_ckpt} --draft-ckpt {input.draft_ckpt} --policy optimal --output {output}"


rule draft_train:
	"""Train the DraftQNetwork against a frozen terminal BrawlModel checkpoint.

	Output is the single .eqx file downstream rules (tier_lists) actually
	consume -- not directory("data/draft_{crawl}") -- because Snakemake wipes
	a directory() output's entire contents before the job runs, which would
	delete the live checkpoint on a rerun before training had produced its
	replacement.
	"""
	input:
		terminal_ckpt="data/terminal_{crawl}/model.eqx",
		events=ancient("data/events.json"),
		brawler_class="data/brawler_class.json",
		brawler_range="data/brawler_effective_range.json",
		brawler_destruction="data/brawler_destruction.json",
	output:
		"data/draft_{crawl}/draft_q_best.eqx"
	shell:
		"just draft-train {input.terminal_ckpt} $(dirname {output})"

